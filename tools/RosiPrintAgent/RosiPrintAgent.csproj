<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RosiPrintAgent</AssemblyName>
    <RootNamespace>RosiPrintAgent</RootNamespace>
    <Version>1.1.0</Version>
    <Product>ROSI Print Agent</Product>
    <Company>ROSI</Company>

    <!-- Single-File, self-contained: laeuft ohne installiertes .NET.
         Build:  dotnet publish -c Release
         Ergebnis: bin/Release/net8.0-windows/win-x64/publish/RosiPrintAgent.exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
