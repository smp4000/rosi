<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RosiPrintSetup</AssemblyName>
    <RootNamespace>RosiPrintSetup</RootNamespace>
    <Version>1.0.0</Version>
    <Product>ROSI Print Setup</Product>

    <!-- Build:  dotnet publish -c Release
         Ergebnis: bin/Release/net8.0-windows/win-x64/publish/RosiPrintSetup.exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Agent + Anleitung werden eingebettet (liegen in payload\, beim Build kopiert) -->
  <ItemGroup>
    <EmbeddedResource Include="payload\RosiPrintAgent.exe" />
    <EmbeddedResource Include="payload\ANLEITUNG.txt" />
  </ItemGroup>

</Project>
